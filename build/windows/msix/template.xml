<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="nemod-jsonui-editor.exe"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\NeMod JSON UI Editor">
    </Installer>
    <PackageInformation
        PackageName="NeMod JSON UI Editor"
        PackageDisplayName="NeMod JSON UI Editor"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.1.0.0"
        PackageDescription="NeMod JSON UI Editor">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.machinacanis.nemodjsonuieditor"
                Description="NeMod JSON UI Editor"
                DisplayName="NeMod JSON UI Editor"
                ExecutableName="nemod-jsonui-editor.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>NeMod JSON UI Editor</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>NeMod JSON UI Editor</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="nemod-jsonui-editor.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
